    "import requests\n",
    "from bs4 import BeautifulSoup\n",
    "url=\"https://www.bbc.com/news/articles/cwr7y8er1n8vo\"\n",
    "Read_data=requests.get(url)\n",
    "data_response=BeautifulSoup(Read_data.text,\"html.parser\")\n",
    "text_data =data_response.find('article')\n",
    "for text in text_data:\n",
    "    print(text.get_text())\n",
    "  "
   ]
